                      <Option type="QString" value="NOT (@map_id = 'carte' AND coalesce(attribute(@feature, 'Zoom'), 0) > 0) AND coalesce(CASE WHEN @map_id = 'carte' THEN attribute(@feature, 'Lh') WHEN @map_id LIKE 'encart%' THEN attribute(@feature, 'Eh') END, 0) = 0" name="expression"/>
